{
  "name": "astraeus-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite packages/astraeus-site",
    "build": "vite build packages/astraeus-site",
    "typecheck": "tsc --noEmit",
    "check:browser": "node packages/astraeus-site/tools/validate/run-browser.mjs",
    "test": "vitest run",
    "test:full": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=junit.xml",
    "apollo11:reconstruct": "node packages/astraeus-demo-apollo11/tools/apollo11/run.mjs",
    "check:engine-alone": "node tools/check-engine-alone.mjs",
    "check:pack": "node tools/check-packs.mjs",
    "build:packages": "node tools/build-packages.mjs",
    "build:example": "node tools/build-example.mjs",
    "lint": "node --require ./tools/lint/use-typescript6.cjs node_modules/eslint/bin/eslint.js packages tools"
  },
  "dependencies": {
    "@lizard-isana/orb": "3.1.1"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.169.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "^21.0.4",
    "playwright-core": "1.59.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.169.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/eslint-plugin": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/parser": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/type-utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/typescript-estree": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/utils": {
      "typescript": "$typescript"
    },
    "ts-api-utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/tsconfig-utils": {
      "typescript": "$typescript"
    }
  },
  "workspaces": [
    "packages/*"
  ]
}
