{
  "name": "astraeus",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:engine": "node tools/validate/run-engine.mjs",
    "check:browser": "node tools/validate/run-browser.mjs",
    "check:demo": "node tools/validate/run-demo.mjs",
    "test": "vitest run",
    "test:full": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=junit.xml",
    "apollo11:reconstruct": "node tools/apollo11/run.mjs",
    "lint": "node --require ./tools/lint/use-typescript6.cjs node_modules/eslint/bin/eslint.js src tests tools"
  },
  "dependencies": {
    "@lizard-isana/orb": "3.1.1",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright-core": "1.59.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/eslint-plugin": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/parser": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/type-utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/typescript-estree": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/utils": {
      "typescript": "$typescript"
    },
    "ts-api-utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/tsconfig-utils": {
      "typescript": "$typescript"
    }
  }
}
