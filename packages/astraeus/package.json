{
  "name": "astraeus",
  "version": "0.1.0",
  "description": "The Astraeus engine and shell: scientific core, body catalogue, scene, shell and made-up experiences.",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@lizard-isana/orb": "3.1.1",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "x-internal-exports": "Only \".\" is the public API (0.1 preview). Every other entry is internal, kept for the demos and the site, and may change without notice.",
