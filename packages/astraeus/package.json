{
  "name": "astraeus",
  "version": "0.2.0",
  "description": "A 3D solar system engine for the browser: place bodies and recorded paths in a scene, mount it, and get time controls, camera, scale choice and body info. Planet positions and the main pictures included.",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@lizard-isana/orb": "3.1.1"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9.8.2 <10",
    "react": ">=19 <19.4",
    "react-dom": ">=19 <19.4",
    "three": ">=0.169.0 <1"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.169.0"
  },
  "x-internal-exports": "Only \".\" is the public API (0.2 preview). Every other entry is internal, kept for the demos and the site, and may change without notice.",
  "exports": {
    ".": "./src/api/index.ts",
    "./app/*": "./src/app/*.ts",
    "./assets/*": "./src/assets/*.ts",
    "./core/*": "./src/core/*.ts",
    "./experiences/*": "./src/experiences/*.ts",
    "./shell/*": "./src/shell/*.ts",
    "./synthetic/*": "./src/synthetic/*.ts",
    "./data/*": "./data/*",
    "./tests/*": "./tests/*.ts",
    "./app/App": "./src/app/App.tsx",
    "./app/CameraController": "./src/app/CameraController.tsx",
    "./app/DebugOverlay": "./src/app/DebugOverlay.tsx",
    "./app/style.css": "./src/app/style.css",
    "./assets/stars/hyg-v42-naked-eye.json": "./src/assets/stars/hyg-v42-naked-eye.json",
    "./shell/AstraeusShell": "./src/shell/AstraeusShell.tsx",
    "./shell/MetricVisual": "./src/shell/MetricVisual.tsx",
    "./shell/MoonFamilyPanel": "./src/shell/MoonFamilyPanel.tsx",
    "./shell/ScaleControl": "./src/shell/ScaleControl.tsx",
    "./shell/StoryPanelView": "./src/shell/StoryPanelView.tsx",
    "./shell/SwitchControl": "./src/shell/SwitchControl.tsx",
    "./tools/import/test-io.mjs": "./tools/import/test-io.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "homepage": "https://astraeus.anipatke.com/api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anipatke/Astraeus.git"
  },
  "keywords": [
    "astronomy",
    "solar-system",
    "three",
    "react-three-fiber",
    "orbit",
    "ephemeris",
    "space"
  ],
  "x-publish": {
    "exports": {
      ".": {
        "types": "./src/api/index.d.ts",
        "node": "./src/api/index.node.js",
        "import": "./src/api/index.js"
      },
      "./style.css": "./src/app/style.css"
    },
    "files": [
      "src",
      "data",
      "README.md",
      "CHANGELOG.md",
      "NOTICE",
      "LICENSE",
      "licenses"
    ]
  }
}
