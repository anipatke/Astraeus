{
  "name": "astraeus-data",
  "version": "0.9.1",
  "description": "Pictures and place lists for the Astraeus engine: maps of the moons, the 8k Venus map, the Milky Way and the tagged surface places of 24 bodies. Optional; the engine draws without them.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anipatke/Astraeus.git"
  },
  "keywords": [
    "astraeus",
    "astronomy",
    "solar-system",
    "textures",
    "moons"
  ],
  "peerDependencies": {
    "astraeus": ">=0.9.0 <0.10.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./bodies/*": "./data/bodies/*",
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "x-publish": {
    "exports": {
      ".": {
        "types": "./src/index.d.ts",
        "import": "./src/index.js"
      },
      "./bodies/*": "./data/bodies/*",
      "./package.json": "./package.json"
    },
    "files": [
      "src",
      "data",
      "README.md",
      "CHANGELOG.md",
      "NOTICE",
      "LICENSE",
      "licenses"
    ],
    "linkData": true
  }
}
