{
  "name": "astraeus-data",
  "version": "0.1.0",
  "description": "Pictures for the Astraeus engine: maps of the moons, the 8k Venus map and the Milky Way. Optional; the engine draws without them.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anipatke/Astraeus.git"
  },
  "keywords": [
    "astraeus",
    "astronomy",
    "solar-system",
    "textures",
    "moons"
  ],
  "peerDependencies": {
    "astraeus": ">=0.1.0 <1.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "x-publish": {
    "exports": {
      ".": {
        "types": "./src/index.d.ts",
        "import": "./src/index.js"
      },
      "./package.json": "./package.json"
    },
    "files": [
      "src",
      "README.md",
      "NOTICE",
      "LICENSE",
      "licenses"
    ]
  }
}
