{
  "name": "astraeus-data-saturn",
  "version": "0.4.0",
  "description": "Saturn's moon positions for the Astraeus engine: piecewise Chebyshev fits of JPL Horizons state vectors, 2010 to 2030, the main moons and the planet from 1950.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anipatke/Astraeus.git"
  },
  "keywords": [
    "astraeus",
    "astronomy",
    "ephemeris",
    "moons",
    "saturn"
  ],
  "peerDependencies": {
    "astraeus": ">=0.1.0 <1.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./index.json": "./data/saturn-moons/index.json",
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "x-publish": {
    "exports": {
      ".": {
        "types": "./src/index.d.ts",
        "import": "./src/index.js"
      },
      "./index.json": "./data/saturn-moons/index.json",
      "./package.json": "./package.json"
    },
    "files": [
      "src",
      "data",
      "README.md",
      "NOTICE",
      "LICENSE",
      "licenses"
    ],
    "linkData": true
  }
}
